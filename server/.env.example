PORT=3001
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/obrateatral
SESSION_SECRET=change-me
# 32-byte hex key (openssl rand -hex 32) used to encrypt studio links at rest.
# If your local DATABASE_URL points at the same database as Render, use the SAME
# value or previously saved links will not decrypt. Without it, links stay in
# server memory only.
LINK_KEY=
