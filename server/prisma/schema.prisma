// obrateatral — data model
// Six works, two people. Room = estado de la sala compartida (ephemeral video link, server is the playback authority).
// WatchProgress = historial de posiciones por usuario (Room != progreso personal).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String          @id @default(cuid())
  name         String          @unique
  passwordHash String
  /// "admin" can manage accounts from the web; "member" can only watch.
  role         String          @default("member")
  createdAt    DateTime        @default(now())

  progress WatchProgress[]
}

model Play {
  id              String          @id
  title           String
  description     String
  durationMinutes Int
  order           Int

  room     Room?
  progress WatchProgress[]
}

model WatchProgress {
  id           String   @id @default(cuid())
  userId       String
  playId       String
  lastPosition Float    @default(0)
  completed    Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  play Play @relation(fields: [playId], references: [id], onDelete: Cascade)

  @@unique([userId, playId])
}

model Room {
  id        String   @id // roomId (la sala de una obra)
  playId    String   @unique
  sourceUrl String?
  isPlaying Boolean  @default(false)
  baseTime  Float    @default(0)
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  play Play @relation(fields: [playId], references: [id], onDelete: Cascade)
}
