// obrateatral — data model
//
// The app stores ACCOUNTS and SESSION METADATA. The studio link is persisted
// only encrypted at rest (AES-256-GCM, key in LINK_KEY): the database never
// holds the plaintext URL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String   @unique
  passwordHash String
  /// "admin" can manage accounts from the web; "member" can only watch.
  role         String   @default("member")
  createdAt    DateTime @default(now())
}

/// One analysis meeting. The name is free text chosen by the user, and the only
/// progress stored is how many seconds into the video the session was.
model Session {
  id              String    @id @default(cuid())
  name            String
  positionSeconds Float     @default(0)
  /// Studio link encrypted at rest with AES-256-GCM. Never the plaintext URL.
  sourceUrlEnc    String?
  /// Exact expiry derived from the link's `s` + `e` params, when present.
  sourceExpiresAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
