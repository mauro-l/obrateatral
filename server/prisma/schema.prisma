// obrateatral — data model
//
// Deliberately minimal: the app stores ACCOUNTS and SESSION METADATA only.
// No video URL is ever persisted anywhere — the studio link lives in server
// memory for the duration of a session and dies with it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String   @unique
  passwordHash String
  /// "admin" can manage accounts from the web; "member" can only watch.
  role         String   @default("member")
  createdAt    DateTime @default(now())
}

/// One analysis meeting. The name is free text chosen by the user, and the only
/// progress stored is how many seconds into the video the session was.
model Session {
  id              String   @id @default(cuid())
  name            String
  positionSeconds Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
